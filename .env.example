# Tickmark settings. Copy to .env next to compose.yaml (git ignores .env) and uncomment what you need.
# Docker Compose reads this file for the compose.yaml placeholders, and passes it to the container.
# Everything is optional: with none of it, Tickmark runs on http://127.0.0.1:8087 with no sign-in.

# ── Docker Compose ─────────────────────────────────────────────────────────────────────────────────
# Address the port is published on. 127.0.0.1 = this machine only; 0.0.0.0 = your network too
# (turn on sign-in first, or put Tickmark behind HTTPS).
#TICKMARK_BIND=127.0.0.1
# Owner of ./vault and ./data on the host; the container runs as this user.
#UID=1000
#GID=1000

# ── General ───────────────────────────────────────────────────────────────────────────────────────
# Time zone for due dates/times sent to and read from CalDAV.
#TZ=Etc/UTC
# Where people open Tickmark. Needed for SSO behind a proxy, and for public share links, which are
# only offered when this is a domain name (not an IP address or localhost).
#TICKMARK_PUBLIC_URL=https://notes.example.com
# How long after a note changes outside Tickmark (another editor, a sync tool) to sync it, in ms.
#TICKMARK_EXTERNAL_SYNC_MS=3000
# How long after the last edit to record a version in note history, in ms.
#TICKMARK_HISTORY_DELAY_MS=30000
# While the app is open, how often to check that the CalDAV servers answer, in seconds (0 = never).
#TICKMARK_CALDAV_PING_SECONDS=60
# Largest file that can be pasted or attached to a note, in MB.
#TICKMARK_ATTACHMENT_MAX_MB=10

# ── Inside the container (set by the image; only change them if you run Tickmark without Docker) ──
#HOST=0.0.0.0
#PORT=8087
#TICKMARK_VAULT=/vault
#TICKMARK_DATA=/data

# ── Sign-in ────────────────────────────────────────────────────────────────────────────────────────
# Simplest protection for single-user mode: HTTP Basic auth on everything.
# (Multi-user mode, with its own sign-in screen, is turned on from Settings → Users instead.)
#TICKMARK_USER=me
#TICKMARK_PASS=change-me
# false hides password sign-in, so SSO is the only way in.
#TICKMARK_LOCAL_LOGIN=true
# Behind a reverse proxy: take the client's address from X-Forwarded-For (the last hop), so wrong
# passwords lock out the person trying them, not everyone behind the proxy. Only set it behind a proxy.
#TICKMARK_TRUST_PROXY=true
# With no sign-in at all, Tickmark only answers to IP addresses, names without a dot and local names
# (.lan, .local, .home.arpa, .internal, .ts.net…), against web pages that rename themselves to reach it.
# List other names you open it at here, comma-separated.
#TICKMARK_ALLOWED_HOSTS=notes.myhouse.example
# With several users, only admins can connect CalDAV accounts to addresses inside your network (so no
# one can use the server to probe it). true lets everyone, e.g. for a Radicale server on the LAN.
#TICKMARK_ALLOW_PRIVATE_CALDAV=true
# Used by `node server/users.js passwd <name>` to set a password without a prompt.
#TICKMARK_NEW_PASSWORD=

# ── Demo mode ─────────────────────────────────────────────────────────────────────────────────────
# A public try-it-out instance: no sign-in, and every visitor gets a private sandbox (a copy of the
# sample vault) that is wiped after a while unused. CalDAV sync, users, SSO, branding and public links
# are off. Don't point a demo at your real vault: it uses its own copies under TICKMARK_DATA/demo.
#TICKMARK_DEMO=true
# Folder of notes each sandbox starts from (default: the sample notes in the image, /app/demo).
#TICKMARK_DEMO_SEED=/app/demo
# Minutes without use before a sandbox is wiped.
#TICKMARK_DEMO_IDLE_MINUTES=60
# Sandboxes kept at once; past that, the longest-unused one is wiped to make room.
#TICKMARK_DEMO_MAX_SESSIONS=50
# Notes each sandbox may hold, in MB.
#TICKMARK_DEMO_MAX_MB=5

# ── Single sign-on (OpenID Connect) ─ can also be set in Settings → Single sign-on ────────────────
# Setting the issuer turns on multi-user mode. If neither group setting is set, the first person to
# sign in becomes admin, so set ALLOWED_GROUPS or ADMIN_GROUPS before exposing Tickmark.
#TICKMARK_OIDC_ISSUER=https://auth.example.com
#TICKMARK_OIDC_CLIENT_ID=tickmark
# The client secret also encrypts everyone's saved CalDAV settings.
#TICKMARK_OIDC_CLIENT_SECRET=
# The old secret, for one start while rotating it (settings get re-encrypted with the new one).
#TICKMARK_OIDC_PREVIOUS_CLIENT_SECRET=
#TICKMARK_OIDC_ALLOWED_GROUPS=notes
#TICKMARK_OIDC_ADMIN_GROUPS=admins
#TICKMARK_OIDC_SCOPES=openid profile email
#TICKMARK_OIDC_USERNAME_CLAIM=preferred_username
#TICKMARK_OIDC_GROUPS_CLAIM=groups
# The first SSO sign-in creates the user.
#TICKMARK_OIDC_AUTO_CREATE=true
# true links a first SSO sign-in to an existing password user of the same name. Only if you
# control user names at the provider.
#TICKMARK_OIDC_MATCH_USERNAME=false
#TICKMARK_OIDC_LABEL=Sign in with SSO
# Master key for a client secret saved in Settings (not needed when the secret is set above).
# Generate one with: openssl rand -base64 32
#TICKMARK_SECRET_KEY=
